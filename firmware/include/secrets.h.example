#pragma once
// Copy to secrets.h (build.sh does this for you) and fill in.
// secrets.h is git-ignored.

#define WIFI_SSID "your-wifi"
#define WIFI_PASSWORD "your-password"

// Base URL of the plant server, no trailing slash.
// https:// is recommended; it needs firmware/root_ca.pem (see README).
#define SERVER_URL "https://plants.home.arpa"

// Must match device_key in the server's config.toml
#define DEVICE_KEY "CHANGE-ME"

// Optional fixed device id. By default each node reports
// "plant-<last 3 bytes of its MAC>", so one firmware build works for all pots.
// #define DEVICE_ID "plant-monstera"
